# ====== Supabase ======
# Project URL and anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, never expose to the browser.
# Used for admin actions like creating users on behalf of OnVex staff.
SUPABASE_SERVICE_ROLE_KEY=

# ====== Stripe ======
# Server-only secret key (sk_test_... or sk_live_...).
STRIPE_SECRET_KEY=

# Webhook signing secret from `stripe listen` or the dashboard.
STRIPE_WEBHOOK_SECRET=

# Public publishable key for Stripe.js in the browser (pk_test_... or pk_live_...).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ====== Resend (email) ======
RESEND_API_KEY=

# Default From address — must be a verified domain in Resend.
RESEND_FROM="OnVex <noreply@onvex.dev>"

# ====== App config ======
# Public site URL — used to construct redirects, email links, etc.
# Example: https://onvex.example.com  (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
